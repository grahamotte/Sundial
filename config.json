{
  "domain": "sundial.rsvp",
  "githubRepo": "git@github.com:grahamotte/Sundial.git",
  "database": "sundial",
  "operatorOnlyEnvKeys": [
    "APPLE_*",
    "CLOUDFLARE_TOKEN",
    "DEPLOY_PASSWORD",
    "DEPLOY_SSH_KEY_*",
    "DIGITAL_OCEAN_TOKEN"
  ],
  "site": {
    "title": "Sundial",
    "description": "Schedule local commands on macOS and see every run.",
    "themeColor": "oklch(0 0 0)"
  },
  "subdomains": [
    {
      "name": "website",
      "subdomains": [
        "",
        "www"
      ],
      "source": "website"
    }
  ],
  "instance": {
    "region": "sfo3",
    "size": "s-1vcpu-2gb"
  },
  "apps": {
    "build": "0.6.0",
    "homebrew": {
      "desc": "Schedule local commands and see whether each run passed or failed",
      "macos": "golden_gate",
      "zap": [
        "~/Library/Application Support/Sundial",
        "~/Library/LaunchAgents/com.grahamotte.sundial.job.*.plist",
        "~/Library/Preferences/com.grahamotte.sundial.plist"
      ]
    },
    "marketingUrl": "https://github.com/grahamotte/Sundial",
    "name": "Sundial",
    "skip_app_stores": true,
    "supportUrl": "https://github.com/grahamotte/Sundial",
    "targets": {
      "apple": {
        "macos": {
          "archiveDestination": "generic/platform=macOS",
          "bundleIdentifier": "com.grahamotte.sundial",
          "platform": "MAC_OS",
          "project": "apps/apple/App.xcodeproj",
          "scheme": "Sundial",
          "simulatorDestination": "platform=macOS",
          "simulatorProduct": "Debug/Sundial.app",
          "simulators": {
            "macos": "Mac"
          }
        }
      },
      "android": {}
    },
    "version": "0.6.0",
    "whatsNew": "Jobs can now skip a run that would start too late after its scheduled time, such as after a long sleep, and show it as Skipped. Run Now always runs. The menu bar icon is now a sundial gnomon."
  }
}
