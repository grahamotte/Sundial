{
  "domain": "sundial.graham.lol",
  "githubRepo": "git@github.com:grahamotte/Sundial.git",
  "database": "sundial",
  "site": {
    "title": "Sundial",
    "description": "Schedule local commands on macOS and see every run.",
    "themeColor": "oklch(0 0 0)"
  },
  "subdomains": [
    {
      "name": "www",
      "subdomains": [
        "",
        "www"
      ],
      "directory": "frontend/subdomains/www"
    },
    {
      "name": "hc",
      "subdomains": [
        "hc"
      ],
      "directory": "frontend/subdomains/hc"
    },
    {
      "name": "jobs",
      "subdomains": [
        "jobs"
      ],
      "backend": true
    }
  ],
  "instance": {
    "region": "sfo3",
    "size": "s-1vcpu-2gb"
  },
  "apps": {
    "build": "0.2.1",
    "marketingUrl": "https://github.com/grahamotte/Sundial",
    "name": "Sundial",
    "skip_app_stores": true,
    "supportUrl": "https://github.com/grahamotte/Sundial",
    "targets": {
      "apple": {
        "macos": {
          "archiveDestination": "generic/platform=macOS",
          "bundleIdentifier": "com.grahamotte.sundial",
          "platform": "MAC_OS",
          "project": "apps/apple/App.xcodeproj",
          "scheme": "Sundial",
          "simulatorDestination": "platform=macOS",
          "simulatorProduct": "Debug/Sundial.app",
          "simulators": {
            "macos": "Mac"
          }
        }
      },
      "android": {}
    },
    "version": "0.2.1",
    "whatsNew": "Settings now opens in the main window from a button at the bottom of the sidebar instead of a separate window."
  }
}
