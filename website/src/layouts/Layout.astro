---
import config from "../../../config.json";
import Sundial from "../components/Sundial.astro";
import "../styles.css";

const { title } = Astro.props as { title?: string };
const repoUrl = config.apps.marketingUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${config.site.title}` : `${config.site.title}: ${config.site.description}`}</title>
    <meta name="description" content={config.site.description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fffdf8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1f21" />
    <meta property="og:title" content={config.site.title} />
    <meta property="og:description" content={config.site.description} />
    <meta property="og:image" content={new URL("/screenshot.webp", Astro.site)} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="m-0 flex min-h-dvh flex-col">
    <div class="sky pointer-events-none fixed inset-0 -z-10" aria-hidden="true"></div>
    <header data-header class="sticky top-0 z-10 bg-paper/85 backdrop-blur-md lg:static lg:bg-transparent lg:backdrop-blur-none">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4 sm:px-8 lg:py-5">
        <a href="/" class="flex items-center gap-2.5 font-rounded text-[1.0625rem] font-semibold no-underline">
          <img src="/icon.png" alt="" width="28" height="28" class="size-7" />
          {config.site.title}
        </a>
        <div class="flex items-center gap-5">
          <div data-header-dial class="flex items-center gap-2 opacity-0 transition-opacity duration-300 lg:hidden" aria-hidden="true">
            <Sundial name="header" size="small" class="w-10" />
            <span data-clock class="font-rounded text-sm font-semibold tabular-nums"></span>
          </div>
          <a href={repoUrl} class="text-[0.9375rem] text-muted no-underline hover:text-ink">GitHub</a>
        </div>
      </div>
    </header>
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <footer class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-hairline px-6 py-8 text-sm text-muted sm:px-8">
      <span>Free forever. Open source under the MIT license.</span>
      <nav class="flex gap-6">
        <a href={repoUrl} class="no-underline hover:text-ink">Source</a>
        <a href={`${repoUrl}/releases`} class="no-underline hover:text-ink">Releases</a>
        <a href={`${repoUrl}/issues`} class="no-underline hover:text-ink">Issues</a>
        <a href="/privacy" class="no-underline hover:text-ink">Privacy</a>
      </nav>
    </footer>
  </body>
</html>

<script>
  const headerDial = document.querySelector<HTMLElement>("[data-header-dial]");
  const heroDial = document.querySelector("[data-hero-dial]");
  if (headerDial && heroDial) {
    new IntersectionObserver(([entry]) => headerDial.classList.toggle("opacity-0", entry.isIntersecting), {
      rootMargin: "-64px 0px 0px 0px",
    }).observe(heroDial);
  } else {
    headerDial?.classList.remove("opacity-0");
  }
</script>
